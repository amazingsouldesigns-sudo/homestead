# ============================================
# HOMESTEAD - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_LISTING_PRICE_ID=price_your-listing-price-id
STRIPE_FEATURED_PRICE_ID=price_your-featured-price-id

# --- Maps (Leaflet + OpenStreetMap via CDN in app/layout.tsx; no API key) ---
# Optional: only if you reintroduce Google elsewhere
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- RapidAPI (US Real Estate — sync script only) ---
# Get key + exact X-RapidAPI-Host from your API’s page on rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_HOST=us-real-estate.p.rapidapi.com
# Default matches this API (no /api prefix). Override only if your provider differs.
RAPIDAPI_BASE_URL=https://us-real-estate.p.rapidapi.com
RAPIDAPI_FOR_SALE_PATH=/v3/for-sale
# Rentals (California example): use for-rent path + CA + a city (API requires city + state_code)
# RAPIDAPI_SEARCH_PATH=/v3/for-rent
# RAPIDAPI_SYNC_PROPERTY_STATUS=for_rent
# RAPIDAPI_SYNC_CITY=Los Angeles
# RAPIDAPI_SYNC_STATE_CODE=CA
# Optional: override full URL (skips building from path + query)
# RAPIDAPI_SEARCH_URL=
# RAPIDAPI_FOR_SALE_URL=
# Sync region for npm run sync:rapidapi (rerun with other cities/states to add more)
RAPIDAPI_SYNC_CITY=Houston
RAPIDAPI_SYNC_STATE_CODE=TX
# for_sale | for_rent — how rows are stored (defaults from path: *rent* → for_rent)
# RAPIDAPI_SYNC_PROPERTY_STATUS=for_sale
# Optional ZIP / neighborhood (from /location/suggest)
# RAPIDAPI_SYNC_LOCATION=
RAPIDAPI_SYNC_LIMIT=42
RAPIDAPI_SYNC_OFFSET=0
RAPIDAPI_SYNC_SORT=newest
# Max images stored per imported listing (default 2000; search API may still return only a few URLs)
RAPIDAPI_MAX_PHOTOS_PER_LISTING=2000
# Extra API call per listing to merge full photo gallery from property-detail (uses more quota)
RAPIDAPI_FETCH_DETAIL_PHOTOS=true
RAPIDAPI_PROPERTY_DETAIL_PATH=/v3/property-detail
# If detail 404s, check RapidAPI docs; some specs use /api/v3/property-detail
RAPIDAPI_DETAIL_DELAY_MS=120
# Backfill existing imported rows only (no /for-sale pagination import)
# RAPIDAPI_BACKFILL_ONLY=1
# Optional backfill filters (defaults to RAPIDAPI_SYNC_CITY / RAPIDAPI_SYNC_STATE_CODE when set)
# RAPIDAPI_BACKFILL_CITY=Pasadena
# RAPIDAPI_BACKFILL_STATE_CODE=CA
# Set to 1 to print truncated JSON when sync parses 0 listings (debug response shape / quota messages)
# RAPIDAPI_DEBUG_JSON=1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Homestead
# Rental deals banner: preview rotates through these listings (comma-separated slugs from /properties/[slug])
# Order is preserved. When set, only these active listings are used (for_rent filter is not applied).
# RENTAL_DEALS_PREVIEW_SLUGS=my-rental-a,another-rental-slug

# ZPID import: npm run import:zpids — one ZPID per line in scripts/zpids.txt (or comma list here)
# RAPIDAPI_IMPORT_ZPIDS=2055406736,4567890123
# RAPIDAPI_IMPORT_ZPIDS_FILE=scripts/zpids.txt
# Default property_status for imported rows (for_rent | for_sale); omit to auto-detect from API
# RAPIDAPI_IMPORT_PROPERTY_STATUS=for_rent
# Listing detail: “Contact agent” reveals this email + mailto (NEXT_PUBLIC_ so it’s available in the browser)
NEXT_PUBLIC_CONTACT_AGENT_EMAIL=homesteadagents@gmail.com
# Optional: secondary “Call …” link
# NEXT_PUBLIC_CONTACT_AGENT_PHONE=
# Optional: first name in the “schedule a call” thank-you slide-out (personalized line)
# NEXT_PUBLIC_CONTACT_AGENT_FIRST_NAME=Alex
